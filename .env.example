# Copy to `.env` and fill in your own values. NEVER commit the real .env.

# Required: your Tushare Pro token (https://tushare.pro/user/token)
TUSHARE_TOKEN=your_tushare_token_here

# Optional: only set if you route through a custom / private Tushare endpoint.
# TUSHARE_API_URL=http://api.tushare.pro/dataapi

# Optional: override the data directory (same as --data-dir)
# COMM_DIR=data
